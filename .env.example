# ─────────────────────────────────────────────────────────────────────────────
# NOIRÉ — environment variables
# Copy to `.env.local` for development. On Vercel add them under
# Project → Settings → Environment Variables (Production + Preview).
# Never commit `.env.local`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Data source ──────────────────────────────────────────────────────────────
# "mock"     → in-memory fixtures (current behaviour, no backend required)
# "supabase" → Postgres via Supabase (requires the keys below + migrations applied)
NOIRE_DATA_SOURCE=mock

# ── Supabase (Project → Settings → API) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # safe for the browser (RLS enforced)
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # SERVER ONLY — bypasses RLS. Never expose.
# Used by `npm run db:types` and the Supabase CLI:
SUPABASE_PROJECT_REF=YOUR-PROJECT-REF
# SUPABASE_ACCESS_TOKEN=sbp_...                 # personal token for `supabase link` / `db push`
# SUPABASE_DB_PASSWORD=...                      # database password (CLI only)

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000      # Vercel: https://noire-mu-eight.vercel.app
# Used by Supabase Auth redirects (email links, OAuth callback):
#   <NEXT_PUBLIC_SITE_URL>/api/auth/callback   (add it to Supabase → Auth → URL Configuration → Redirect URLs)

# ── Payments (phase 2 — not wired yet) ───────────────────────────────────────
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...                 # SERVER ONLY
# STRIPE_WEBHOOK_SECRET=whsec_...               # SERVER ONLY — verifies webhook signatures

# ── Email (phase 2 — order confirmations) ────────────────────────────────────
# RESEND_API_KEY=re_...
# EMAIL_FROM="NOIRÉ <orders@your-domain.com>"

# ── Seeding (scripts/seed-supabase.ts) ───────────────────────────────────────
# Email of the first administrator; the seed script promotes this profile to `admin`.
# SEED_ADMIN_EMAIL=you@example.com
